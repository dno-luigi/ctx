{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ai-Nspired/gca-experiment/schemas/gca-input.v1.json",
  "title": "GCA input v1",
  "description": "One assessment request. Every source is operator-supplied, hashed, and marked observed. Spans are UTF-16 code-unit offsets into content.text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run", "task", "sources", "budgets"],
  "properties": {
    "schema": { "const": "gca-input/v1" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "at", "operator_ref"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "format": "date-time" },
        "operator_ref": { "type": "string", "minLength": 1 }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "deliverable": { "const": "snapshot" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hash", "kind", "label", "media_type", "content", "origin", "observation"],
        "properties": {
          "id": { "type": "string", "pattern": "^s[0-9A-Za-z_-]+$" },
          "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "kind": { "enum": ["document", "image", "page", "transcript", "note"] },
          "label": { "type": "string", "minLength": 1 },
          "media_type": { "type": "string", "minLength": 1 },
          "status": { "enum": ["ready", "pending_capture"] },
          "content": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": { "type": ["string", "null"] },
              "data_url": { "type": ["string", "null"] },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            }
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": ["supplied_by", "method", "captured_at"],
            "properties": {
              "supplied_by": { "const": "operator" },
              "method": { "enum": ["paste", "fixture", "host_export"] },
              "captured_at": { "type": "string", "format": "date-time" },
              "app": { "type": "string" },
              "surface": { "type": "string" }
            }
          },
          "observation": { "const": "observed" }
        }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "authored_by", "at"],
      "properties": {
        "text": { "type": "string" },
        "authored_by": { "const": "operator" },
        "at": { "type": "string", "format": "date-time" }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_input_tokens", "max_sources", "max_bytes"],
      "properties": {
        "max_input_tokens": { "type": "integer", "minimum": 1 },
        "max_sources": { "type": "integer", "minimum": 1 },
        "max_bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
