{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ai-Nspired/gca-experiment/schemas/gca-snapshot.v1.json",
  "title": "GCA snapshot v1",
  "description": "A read-only assessment. It asserts, cites and abstains. It may not contain a decision, a recommendation, a preference or an instruction. Spans are UTF-16 code-unit offsets into the cited source text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run",
    "input_digest",
    "observations",
    "domains",
    "gaps",
    "checks",
    "abstentions"
  ],
  "properties": {
    "schema": { "const": "gca-snapshot/v1" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "at", "model"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "format": "date-time" },
        "harness_version": { "type": "string" },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "slug"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "slug": { "type": "string", "minLength": 1 },
            "temperature": { "type": "number" },
            "max_tokens": { "type": "integer" },
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "cost_usd": { "type": "number", "minimum": 0 },
            "latency_ms": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "input_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["oid", "claim", "kind", "refs", "confidence"],
        "properties": {
          "oid": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["stated", "derived", "inferred"] },
          "refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "quote"],
              "properties": {
                "source_id": { "type": "string", "minLength": 1 },
                "quote": { "type": "string", "minLength": 1 },
                "span": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["start", "end"],
                  "properties": {
                    "start": { "type": "integer", "minimum": 0 },
                    "end": { "type": "integer", "minimum": 1 }
                  }
                },
                "region": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["x", "y", "w", "h"],
                  "properties": {
                    "x": { "type": "integer", "minimum": 0 },
                    "y": { "type": "integer", "minimum": 0 },
                    "w": { "type": "integer", "minimum": 1 },
                    "h": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          },
          "confidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["extraction", "interpretation"],
            "properties": {
              "extraction": { "type": "number", "minimum": 0, "maximum": 1 },
              "interpretation": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "basis"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "enum": ["primary", "secondary", "supporting"] },
          "basis": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["missing", "why"],
        "properties": {
          "missing": { "type": "string", "minLength": 1 },
          "blocks": { "type": "array", "items": { "type": "string" } },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "expected_cost"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "settles": { "type": "array", "items": { "type": "string" } },
          "expected_cost": { "enum": ["low", "medium", "high"] }
        }
      }
    },
    "abstentions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "reason"],
        "properties": {
          "topic": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "brief_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["oid", "against"],
        "properties": {
          "oid": { "type": "string", "minLength": 1 },
          "against": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
