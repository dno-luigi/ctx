    "decisions": [
      {
        "id": "decisions:6f8c255b0b",
        "text": "ADR-002 chose a batch size of 100 because larger batches increased lock contention.",
        "sources": [
          {
            "path": "docs/DECISIONS.md",
            "line": 10,
            "quote": "We chose a batch size of 100 records. Larger batches increased lock contention.",
            "sha256": "sha256:5463801af7594ae5a5fef4d443962261f5ad9c4e6f69e59a51b097998c9cadfa"
          }
        ]
      },
      {
        "id": "decisions:8ccb8f6add",
        "text": "ADR-001 chose a fixed 30-day retention window over a sliding TTL because the audit trail requires a fixed boundary.",
        "sources": [
          {
            "path": "docs/DECISIONS.md",
            "line": 5,
            "quote": "We decided to keep a fixed 30-day retention window rather than a sliding TTL.",
            "sha256": "sha256:5463801af7594ae5a5fef4d443962261f5ad9c4e6f69e59a51b097998c9cadfa"
          },
          {
            "path": "docs/DECISIONS.md",
            "line": 6,
            "quote": "We rejected sliding-window TTL because the audit trail requires a fixed boundary.",
            "sha256": "sha256:5463801af7594ae5a5fef4d443962261f5ad9c4e6f69e59a51b097998c9cadfa"
          }
        ]
      }
    ],
