    "invariants": [
      {
        "id": "invariants:13dc4f1480",
        "text": "The service must never delete an object before its retention window expires.",
        "sources": [
          {
            "path": "README.md",
            "line": 7,
            "quote": "The service MUST never delete an object before its retention window expires.",
            "sha256": "sha256:480999aafefec272670ceeecd4af9075d42adec7b031bd19744b960055d19a64"
          }
        ]
      },
      {
        "id": "invariants:40f134ff6f",
        "text": "Every accepted batch is written exactly once and retries must be idempotent.",
        "sources": [
          {
            "path": "README.md",
            "line": 8,
            "quote": "Every accepted batch is written exactly once; retries MUST be idempotent.",
            "sha256": "sha256:480999aafefec272670ceeecd4af9075d42adec7b031bd19744b960055d19a64"
          }
        ]
      },
      {
        "id": "invariants:a84df9c2f8",
        "text": "The store must never delete an unexpired object even under lock contention.",
        "sources": [
          {
            "path": "src/store.js",
            "line": 4,
            "quote": "The store MUST never delete an unexpired object, even under lock contention.",
            "sha256": "sha256:ffd6908abeae52a691892b506e619d5b7ab9fe6912012d6e0765ec87cfaf144f"
          }
        ]
      }
    ],
    "current_state": [
      {
        "id": "current_state:04ecf423bc",
        "text": "ingest enforces a maximum batch size of 100 by throwing on larger batches.",
        "sources": [
          {
            "path": "src/ingest.js",
            "line": 7,
            "quote": "if (batch.length > MAX_BATCH) throw new Error(`batch too large: ${batch.length}`);",
            "sha256": "sha256:463fbf9ec496dc563d453d9e14ecc35d53fa9d4df69ef51465eac5abec7b00ef"
          }
        ]
      },
      {
        "id": "current_state:248cf02ed9",
        "text": "Retention was 14 days before the audit change and the legacy note is superseded by ADR-001.",
        "sources": [
          {
            "path": "notes/LEGACY-RETENTION.md",
            "line": 3,
            "quote": "Retention was 14 days before the audit change.",
            "sha256": "sha256:1d8e7b87acee2d947b2f3378a4be491e0b4bdcccfe31fceae5d3dafb28ec0210"
          },
          {
            "path": "notes/LEGACY-RETENTION.md",
            "line": 4,
            "quote": "This note is superseded by ADR-001.",
            "sha256": "sha256:1d8e7b87acee2d947b2f3378a4be491e0b4bdcccfe31fceae5d3dafb28ec0210"
          }
        ]
      },
      {
        "id": "current_state:3549d3fd01",
        "text": "Configuration defaults set retention_days 30, timeout_seconds 5, and batch_size 100.",
        "sources": [
          {
            "path": "config/defaults.json",
            "line": 2,
            "quote": "\"retention_days\": 30,",
            "sha256": "sha256:c8672fefac76cd1d07dc8f991b0d1a796e433bc096709ee015d5d3b8ae60b503"
          }
        ]
      },
      {
        "id": "current_state:85ec29b626",
        "text": "Retention expiry uses an inclusive boundary: an object exactly 30 days old is expired.",
        "sources": [
          {
            "path": "src/retention.js",
            "line": 6,
            "quote": "return now - object.created_at >= RETENTION_DAYS * DAY_MS;",
            "sha256": "sha256:2acb9f969a7ada840643c862df28ce7e57eb890bfee182aa2e8965bcf0858afb"
          },
          {
            "path": "tests/retention.test.js",
            "line": 4,
            "quote": "The boundary MUST be inclusive: an object exactly 30 days old is expired.",
            "sha256": "sha256:0e06e67e21bc33a95194e855543eca8bf29df40f7751d884cc84ec4d147b68cb"
          }
        ]
      },
      {
        "id": "current_state:8cc28eb5d5",
        "text": "The scheduler drains the queue every 30 seconds in batches of 100.",
        "sources": [
          {
            "path": "src/scheduler.js",
            "line": 5,
            "quote": "return setInterval(() => ingest(queue.take(100)), 30000);",
            "sha256": "sha256:739ab17cb22ac70b8408926b80a032422d0d0815e17544c66a87b81bb39f0537"
          }
        ]
      }
    ],
    "outstanding": [
      {
        "id": "outstanding:c64b424dd4",
        "text": "The backfill path is not yet implemented and must be documented before the next release.",
        "sources": [
          {
            "path": "README.md",
            "line": 12,
            "quote": "The backfill path is not yet implemented. TODO: document backfill before the next release.",
