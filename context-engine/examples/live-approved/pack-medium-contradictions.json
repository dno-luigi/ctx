      },
      {
        "id": "outstanding:eca87b905f",
        "text": "An open question remains whether backfill may write directly to the store or only through ingest.",
        "sources": [
          {
            "path": "docs/ARCHITECTURE.md",
            "line": 20,
            "quote": "Is backfill allowed to write directly to the store, or only through ingest?",
            "sha256": "sha256:b63d1d7131559917493ebfe17ed40d23653596bd0c09b17162df56aca1d8c817"
          }
        ]
      }
    ],
    "architecture": [
      {
        "id": "architecture:46a5a24825",
        "text": "ingest accepts batches and validates payloads; store handles durable writes and reads; retention owns only the expiry decision; scheduler drives periodic drain work.",
        "sources": [
          {
            "path": "docs/ARCHITECTURE.md",
            "line": 5,
            "quote": "`ingest` is responsible for accepting batches and validating payloads.",
            "sha256": "sha256:b63d1d7131559917493ebfe17ed40d23653596bd0c09b17162df56aca1d8c817"
          },
          {
            "path": "docs/ARCHITECTURE.md",
            "line": 6,
            "quote": "`store` is responsible for durable writes and reads.",
            "sha256": "sha256:b63d1d7131559917493ebfe17ed40d23653596bd0c09b17162df56aca1d8c817"
          },
          {
            "path": "docs/ARCHITECTURE.md",
            "line": 7,
            "quote": "`retention` owns the expiry decision and nothing else.",
            "sha256": "sha256:b63d1d7131559917493ebfe17ed40d23653596bd0c09b17162df56aca1d8c817"
          },
          {
            "path": "docs/ARCHITECTURE.md",
