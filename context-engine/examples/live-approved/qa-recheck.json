  "answers": [
    {
      "question_id": "q1",
      "answer": "The retention window is 30 days (config defaults set retention_days to 30, and expiry is inclusive — an object exactly 30 days old is expired). ADR-001 chose a fixed 30-day retention window over a sliding TTL because the audit trail requires a fixed boundary. This supersedes the legacy 14-day note.",
      "sources": [
        "config/defaults.json",
        "src/retention.js",
        "docs/DECISIONS.md",
        "notes/LEGACY-RETENTION.md"
      ]
    },
    {
      "question_id": "q2",
      "answer": "Directly, ingest imports src/store.js. Transitively, ingest depends on src/retention.js via the chain ingest -> store -> retention.",
      "sources": [
        "src/ingest.js",
        "src/store.js",
        "docs/ARCHITECTURE.md"
      ]
    },
    {
      "question_id": "q3",
      "answer": "The backfill path is not yet implemented and must be documented before the next release. There is also an open question about whether backfill may write directly to the store or only through ingest, which must be resolved.",
      "sources": [
        "README.md",
        "docs/ARCHITECTURE.md"
      ]
    },
    {
      "question_id": "q4",
      "answer": "A sliding TTL was the rejected alternative; ADR-001 chose a fixed 30-day retention window over it because the audit trail requires a fixed boundary.",
      "sources": [
        "docs/DECISIONS.md"
      ]
    },
    {
      "question_id": "q5",
      "answer": "When the store lock is held, the scheduler drops the batch instead of retrying it.",
      "sources": [
        "docs/RUNBOOK.md"
      ]
    },
    {
      "question_id": "q6",
      "answer": "config/defaults.json sets timeout_seconds to 5, but the architecture doc records a 30-second ingest timeout in production. The two do not agree — this is a known contradiction.",
      "sources": [
        "config/defaults.json",
        "docs/ARCHITECTURE.md"
      ]
    }
  ],
