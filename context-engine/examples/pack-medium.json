    "decisions": [
      {
        "id": "decisions:2baaf48118",
        "text": "We decided to keep a fixed 30-day retention window rather than a sliding TTL.",
        "sources": [
          {
            "path": "docs/DECISIONS.md",
            "line": 5,
            "quote": "We decided to keep a fixed 30-day retention window rather than a sliding TTL.",
            "sha256": "sha256:5463801af7594ae5a5fef4d443962261f5ad9c4e6f69e59a51b097998c9cadfa"
          }
        ]
      },
      {
        "id": "decisions:5906548789",
        "text": "retention` owns the expiry decision and nothing else.",
        "sources": [
          {
            "path": "docs/ARCHITECTURE.md",
            "line": 7,
            "quote": "- `retention` owns the expiry decision and nothing else.",
            "sha256": "sha256:b63d1d7131559917493ebfe17ed40d23653596bd0c09b17162df56aca1d8c817"
          }
        ]
      },
      {
        "id": "decisions:725a024912",
        "text": "We chose a batch size of 100 records. Larger batches increased lock contention.",
        "sources": [
          {
            "path": "docs/DECISIONS.md",
            "line": 10,
            "quote": "We chose a batch size of 100 records. Larger batches increased lock contention.",
            "sha256": "sha256:5463801af7594ae5a5fef4d443962261f5ad9c4e6f69e59a51b097998c9cadfa"
          }
        ]
      },
      {
        "id": "decisions:8fd2ebaac5",
        "text": "// Fixed retention policy. ADR-001 chose a fixed boundary over a sliding window.",
        "sources": [
          {
            "path": "src/retention.js",
            "line": 1,
            "quote": "// Fixed retention policy. ADR-001 chose a fixed boundary over a sliding window.",
            "sha256": "sha256:2acb9f969a7ada840643c862df28ce7e57eb890bfee182aa2e8965bcf0858afb"
          }
        ]
      },
      {
        "id": "decisions:9c534fc0b3",
        "text": "We rejected sliding-window TTL because the audit trail requires a fixed boundary.",
